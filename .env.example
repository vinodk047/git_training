# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=mqtt_iot_bridge
MQTT_TOPICS=sensors/#,devices/#
MQTT_QOS=1
MQTT_USE_TLS=false

# Azure IoT Hub Configuration
IOTHUB_CONNECTION_STRING=HostName=<your-iothub>.azure-devices.net;DeviceId=<device-id>;SharedAccessKey=<key>
IOTHUB_DEVICE_ID=mqtt-bridge-device
IOTHUB_MODULE_ID=

# Bridge Configuration
LOG_LEVEL=INFO
RETRY_ENABLED=true
